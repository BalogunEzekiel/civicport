DATABASE_URL="postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:5434/civicport_dev"
PORT=5000

# Government authentication
GOVERNMENT_EMAIL="government.admin@civicport.gov.ng"
GOVERNMENT_PASSWORD_HASH="replace-with-bcrypt-hash"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# CivicPort AI - Groq
# Keep these secrets on the server. Never put them in the React/Vite client.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL_NAME="openai/gpt-oss-120b"
# Vision model used to inspect uploaded evidence images before GPT-OSS triage.
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# NIPOST National Digital Postcode API
# Obtain a real API key from https://dashboard.postcode.gov.ng/
# Keep this secret only in the server environment (e.g. Render).
# The postcode service uses the X-API-Key header.
NIPOST_API_BASE_URL="https://api.postcode.gov.ng"
NIPOST_API_KEY="nipost_test_replace_with_your_real_key"
# Level 1 lookup validates postcode structure/existence; higher levels may consume credits.
NIPOST_LOOKUP_LEVEL=1
NIPOST_TIMEOUT_MS=8000
# Reverse-geocode search radius: documented service maximum is 250m.
NIPOST_REVERSE_GEOCODE_RADIUS_METERS=25
# If the official lookup response includes coordinates, reject a postcode that is farther away than this.
NIPOST_MAX_DISTANCE_METERS=250
